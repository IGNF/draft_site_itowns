---
/**
 * Carrousel d’aperçus aligné sur la home officielle (viewer previews qui défilent).
 * https://www.itowns-project.org/
 */
import BaseSwiper from "@components/BaseSwiper.astro";
import I18n from "@components/I18n.astro";
import { viewerExamples } from "@data/viewerExamples";
import { aboutCopy } from "@i18n/copy/about";
import { bilingualImageAlt } from "@i18n/types";
import { Image } from "astro:assets";

const GOVERNANCE_URL = "#governance";
---

<section id="about" class="about">
  <div class="section-container">
    <h2 class="section-title"><I18n t={aboutCopy.sectionTitle} /></h2>

    <div class="about-container">
      <div class="about-image-wrapper">
        <BaseSwiper sliderName="about" navigation={true} pagination={true}>
          {
            viewerExamples.map((example) => (
              <div class="swiper-slide">
                <div class="about-slide">
                  <a
                    href={example.link}
                    class="about-slide-visual"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Image
                      src={example.thumb}
                      alt={bilingualImageAlt(example.thumbAlt)}
                      width={960}
                      height={540}
                      class="media"
                      loading="lazy"
                    />
                  </a>
                  <p class="about-slide-caption">
                    <I18n t={example.title} />
                  </p>
                  <a
                    href={example.link}
                    class="about-slide-test"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <I18n t={aboutCopy.testExample} />
                  </a>
                </div>
              </div>
            ))
          }
        </BaseSwiper>
      </div>
      <div class="about-content">
        <div class="about-block">
          <h3 class="section-subtitle about-subtitle">
            <I18n t={aboutCopy.technology.title} />
          </h3>
          <p class="about-text"><I18n t={aboutCopy.technology.text} /></p>
        </div>

        <div class="about-toolkit about-block">
          <h3 class="section-subtitle about-toolkit-heading">
            <I18n t={aboutCopy.toolkit.title} />
          </h3>
          <p class="about-toolkit-lead"><I18n t={aboutCopy.toolkit.text} /></p>
        </div>

        <div class="about-block">
          <h3 class="section-subtitle about-subtitle">
            <I18n t={aboutCopy.community.title} />
          </h3>
          <p class="about-text">
            <span class="i18n-en">
              iTowns is based on{" "}
              <a href={GOVERNANCE_URL}>open governance</a>
              {" "}that allows everyone to contribute. The project brings together
              developers, researchers, and geospatial stakeholders to evolve the
              framework together.
            </span>
            <span class="i18n-fr">
              iTowns s’appuie sur une{" "}
              <a href={GOVERNANCE_URL}>gouvernance ouverte</a>
              {" "}qui permet à chacun de contribuer. Le projet rassemble
              développeurs, chercheurs et acteurs géospatiaux pour faire évoluer
              le framework ensemble.
            </span>
          </p>
        </div>

        <div class="about-formats about-block">
          <h3 class="section-subtitle about-formats-heading">
            <I18n t={aboutCopy.formats.title} />
          </h3>
          <p class="about-formats-lead about-text">
            <span class="i18n-en">
              {aboutCopy.formats.textLink.en.before}
              <a
                href={aboutCopy.formats.textLink.href}
                target="_blank"
                rel="noopener noreferrer"
                >{aboutCopy.formats.textLink.en.label}</a
              >
              {aboutCopy.formats.textLink.en.after}
            </span>
            <span class="i18n-fr">
              {aboutCopy.formats.textLink.fr.before}
              <a
                href={aboutCopy.formats.textLink.href}
                target="_blank"
                rel="noopener noreferrer"
                >{aboutCopy.formats.textLink.fr.label}</a
              >
              {aboutCopy.formats.textLink.fr.after}
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import type { Swiper } from "swiper";
  import { initSwiper } from "@utils/initSwiper";

  const SLIDER = "about";
  let instance: Swiper | null = null;

  function setupAboutSwiper() {
    instance?.destroy(true, true);
    instance = initSwiper(SLIDER, {
      autoplay: {
        delay: 4500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      pagination: {
        el: `.${SLIDER}-pagination`,
        clickable: true,
      },
      navigation: {
        prevEl: `.${SLIDER}-prev`,
        nextEl: `.${SLIDER}-next`,
      },
    });
  }

  setupAboutSwiper();
  document.addEventListener("astro:after-swap", setupAboutSwiper);
</script>

<style>
  /** Fluid heading width on small viewports. */
  .about > .section-container > .section-title {
    font-size: clamp(1rem, 0.68rem + 2.55vi, 3rem);
    line-height: 1.14;
    text-wrap: balance;
    margin-bottom: var(--px-40, 2.5rem);
  }

  .about-content {
    max-width: 37.5rem;
    font-size: clamp(0.875rem, 0.82rem + 0.2vi, 0.9375rem);
    display: flex;
    flex-direction: column;
    gap: var(--px-24, 1.5rem);
  }

  .about-content > .about-block {
    display: flex;
    flex-direction: column;
    gap: var(--px-8, 0.5rem);
  }

  .about-content .about-block :is(.section-subtitle) {
    font-size: clamp(1rem, 0.92rem + 0.35vi, var(--text-lg));
    font-weight: 600;
    margin: 0;
    line-height: 1.28;
  }

  .about-content .about-text,
  .about-content .about-toolkit-lead,
  .about-content .about-formats-lead {
    line-height: 1.52;
    margin: 0;
  }

  .about-content .about-toolkit-lead,
  .about-content .about-formats-lead {
    opacity: 0.92;
  }

  .about-content .about-formats-lead {
    max-width: none;
  }

  .about-content .about-toolkit {
    margin: 0;
    padding: 0;
    border: none;
  }

  .about-toolkit-heading {
    margin: 0;
  }

  .about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    align-items: start;
  }

  .about-image-wrapper {
    width: 100%;
    min-width: 0;
  }

  @media screen and (min-width: 48.0625rem) {
    .about-image-wrapper {
      margin-top: var(--px-28, 1.75rem);
    }
  }

  .about-image-wrapper :global(.about-showcase) {
    width: 100%;
  }

  .about-image-wrapper :global(.about-swiper) {
    position: relative;
    width: 100%;
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
    border: 1px solid var(--color-border-card);
    background: var(--color-surface-muted);
  }

  .about-slide {
    display: flex;
    flex-direction: column;
    gap: var(--px-12);
    padding-bottom: var(--px-4);
  }

  .about-slide-visual {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm, 4px);
  }

  .about-slide-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-slide-caption {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .about-slide-test {
    align-self: flex-start;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--transition-short);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-slide-test:hover {
      opacity: 0.75;
    }
  }

  .about-text a {
    font-weight: 500;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity var(--transition-short);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-text a:hover {
      opacity: 0.75;
    }
  }

  @media screen and (max-width: 64rem) {
    .about-container {
      gap: var(--px-32);
    }

    .about-content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-container {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .about-image-wrapper {
      order: -1;
    }
  }
</style>
