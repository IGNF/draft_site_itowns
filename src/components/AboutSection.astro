---
/**
 * Carrousel d’aperçus aligné sur la home officielle (viewer previews qui défilent).
 * https://www.itowns-project.org/
 */
import BaseSwiper from "@components/BaseSwiper.astro";
import I18n from "@components/I18n.astro";
import { Image } from "astro:assets";
/** Captures de la home officielle : /assets/images/home-examples/ (copiées en local). */
import picGlobe from "/src/assets/images/home-examples/example-globe.png";
import picPlanar from "/src/assets/images/home-examples/example-planar.png";
import picVector from "/src/assets/images/home-examples/example-vector-tiles.png";
import pic3d from "/src/assets/images/home-examples/example-3d-tiles.png";
import picCopc from "/src/assets/images/home-examples/example-copc.png";
import picDsm from "/src/assets/images/home-examples/example-dsm.png";

const technologyContent = {
  title: {
    en: "Technology and purpose",
    fr: "Technologie et objectifs",
  },
  text: {
    en: "iTowns is designed to help developers integrate mapping and 3D visualization in web applications, from operational GIS interfaces to digital twin experiences.",
    fr: "iTowns aide les développeurs à intégrer cartographie et visualisation 3D dans des applications web, des interfaces SIG opérationnelles aux expériences de jumeau numérique.",
  },
};

const communityContent = {
  title: {
    en: "Open source and community",
    fr: "Open source et communauté",
  },
};

const multipleFormatSupport = {
  title: {
    en: "Multiple format support",
    fr: "Prise en charge de nombreux formats",
  },
  text: {
    en: "From OGC 3D Tiles and vector layers to terrain, imagery, and point clouds, iTowns combines many data families in one web viewer. Load GeoTIFF or COG rasters, Mapbox Vector Tiles, Potree / EPT / COPC or LAS point clouds, and WMS or streaming services in the same scene—so your app stays aligned with common GIS and BIM pipelines.",
    fr: "Des 3D Tiles OGC et couches vectorielles au relief, à l’imagerie et aux nuages de points, iTowns réunit de nombreuses familles de données dans une visionneuse web. Chargez des rasters GeoTIFF ou COG, des tuiles vectorielles Mapbox, des nuages de points Potree / EPT / COPC ou LAS, et des services WMS ou flux dans une même scène — pour rester aligné avec les chaînes SIG et BIM courantes.",
  },
};

const EXAMPLES_BASE = "https://itowns.github.io/itowns/examples";

const viewerSlides = [
  {
    title: { en: "Globe viewer", fr: "Visionneuse globe" },
    thumb: picGlobe,
    thumbAlt: {
      en: "Screenshot — globe viewer example",
      fr: "Capture — exemple visionneuse globe",
    },
    link: `${EXAMPLES_BASE}/view_3d_map.html`,
  },
  {
    title: { en: "Planar viewer", fr: "Visionneuse plane" },
    thumb: picPlanar,
    thumbAlt: {
      en: "Screenshot — planar viewer example",
      fr: "Capture — exemple visionneuse plane",
    },
    link: `${EXAMPLES_BASE}/view_25d_map.html`,
  },
  {
    title: { en: "Vector Tiles viewer", fr: "Visionneuse tuiles vectorielles" },
    thumb: picVector,
    thumbAlt: {
      en: "Screenshot — vector tiles example",
      fr: "Capture — exemple tuiles vectorielles",
    },
    link: `${EXAMPLES_BASE}/vector_tile_3d_mesh_mapbox.html`,
  },
  {
    title: { en: "3D tiles viewer", fr: "Visionneuse 3D Tiles" },
    thumb: pic3d,
    thumbAlt: {
      en: "Screenshot — 3D Tiles example",
      fr: "Capture — exemple 3D Tiles",
    },
    link: `${EXAMPLES_BASE}/3dtiles_loader.html`,
  },
  {
    title: { en: "Point cloud viewer", fr: "Visionneuse nuage de points" },
    thumb: picCopc,
    thumbAlt: {
      en: "Screenshot — point cloud example",
      fr: "Capture — exemple nuage de points",
    },
    link: `${EXAMPLES_BASE}/copc_simple_loader.html?copc=https%3A%2F%2Fs3.amazonaws.com%2Fhobu-lidar%2Fautzen-classified.copc.laz`,
  },
  {
    title: { en: "Raster data viewer", fr: "Visionneuse données raster" },
    thumb: picDsm,
    thumbAlt: {
      en: "Screenshot — raster / DSM example",
      fr: "Capture — exemple raster / MNS",
    },
    link: `${EXAMPLES_BASE}/view_3d_mns_map.html`,
  },
];
---

<section id="about" class="about">
  <div class="section-container">
    <h2 class="section-title">
      <I18n
        en="Build your own 3D geographic service."
        fr="Créez votre propre service géographique 3D."
      />
    </h2>

    <div class="about-container">
      <div class="about-image-wrapper">
        <BaseSwiper sliderName="about" navigation={true} pagination={true}>
          {
            viewerSlides.map((slide) => (
              <div class="swiper-slide">
                <div class="about-slide">
                  <a
                    href={slide.link}
                    class="about-slide-visual"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Image
                      src={slide.thumb}
                      alt={`${slide.thumbAlt.en} — ${slide.thumbAlt.fr}`}
                      width={960}
                      height={540}
                      class="media"
                      loading="lazy"
                    />
                  </a>
                  <p class="about-slide-caption">
                    <I18n en={slide.title.en} fr={slide.title.fr} />
                  </p>
                  <a
                    href={slide.link}
                    class="about-slide-test"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <I18n en="Test the example" fr="Tester l'exemple" />
                  </a>
                </div>
              </div>
            ))
          }
        </BaseSwiper>
      </div>
      <div class="about-content">
        <div class="about-block">
          <h3 class="section-subtitle about-subtitle">
            <I18n
              en={technologyContent.title.en}
              fr={technologyContent.title.fr}
            />
          </h3>
          <p class="about-text">
            <I18n en={technologyContent.text.en} fr={technologyContent.text.fr} />
          </p>
        </div>

        <div class="about-toolkit about-block">
          <h3 class="section-subtitle about-toolkit-heading">
            <I18n
              en="Swiss army knife for geographic data"
              fr="Couteau suisse des données géographiques"
            />
          </h3>
          <p class="about-toolkit-lead">
            <I18n
              en="iTowns offers a comprehensive toolkit for visualizing, interacting and composing diverse spatial datasets. Mix point clouds, terrain, orthophotos and vector data in a single view: easily extend the engine for your needs, build your application from simple blocks."
              fr="iTowns propose une boîte à outils complète pour visualiser, interagir et composer des jeux de données spatiales variés. Mélangez nuages de points, relief, orthophotos et données vectorielles dans une même vue : étendez facilement le moteur à vos besoins et assemblez votre application à partir de briques simples."
            />
          </p>
        </div>

        <div class="about-block">
          <h3 class="section-subtitle about-subtitle">
            <I18n en={communityContent.title.en} fr={communityContent.title.fr} />
          </h3>
          <p class="about-text">
            <span class="i18n-en">
              iTowns is based on{" "}
              <a
                href="https://github.com/iTowns/itowns-governance"
                target="_blank"
                rel="noopener noreferrer">open governance</a
              >
              {" "}that allows everyone to contribute. The project brings together
              developers, researchers, and geospatial stakeholders to evolve the
              framework together.
            </span>
            <span class="i18n-fr">
              iTowns s’appuie sur une{" "}
              <a
                href="https://github.com/iTowns/itowns-governance"
                target="_blank"
                rel="noopener noreferrer">gouvernance ouverte</a
              >
              {" "}qui permet à chacun de contribuer. Le projet rassemble
              développeurs, chercheurs et acteurs géospatiaux pour faire évoluer
              le cadriciel ensemble.
            </span>
          </p>
        </div>

        <div class="about-formats about-block">
          <h3 class="section-subtitle about-formats-heading">
            <I18n
              en={multipleFormatSupport.title.en}
              fr={multipleFormatSupport.title.fr}
            />
          </h3>
          <p class="about-formats-lead">
            <I18n
              en={multipleFormatSupport.text.en}
              fr={multipleFormatSupport.text.fr}
            />
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import type { Swiper } from "swiper";
  import { initSwiper } from "@utils/initSwiper";

  const SLIDER = "about";
  let instance: Swiper | null = null;

  function setupAboutSwiper() {
    instance?.destroy(true, true);
    instance = initSwiper(SLIDER, {
      autoplay: {
        delay: 4500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      pagination: {
        el: `.${SLIDER}-pagination`,
        clickable: true,
      },
      navigation: {
        prevEl: `.${SLIDER}-prev`,
        nextEl: `.${SLIDER}-next`,
      },
    });
  }

  setupAboutSwiper();
  document.addEventListener("astro:after-swap", setupAboutSwiper);
</script>

<style>
  /** Fluid heading width on small viewports. */
  .about > .section-container > .section-title {
    font-size: clamp(1rem, 0.68rem + 2.55vi, 3rem);
    line-height: 1.14;
    text-wrap: balance;
    margin-bottom: var(--px-40, 2.5rem);
  }

  .about-content {
    max-width: 37.5rem;
    font-size: clamp(0.875rem, 0.82rem + 0.2vi, 0.9375rem);
    display: flex;
    flex-direction: column;
    gap: var(--px-24, 1.5rem);
  }

  .about-content > .about-block {
    display: flex;
    flex-direction: column;
    gap: var(--px-8, 0.5rem);
  }

  .about-content .about-block :is(.section-subtitle) {
    font-size: clamp(1rem, 0.92rem + 0.35vi, var(--text-lg));
    font-weight: 600;
    margin: 0;
    line-height: 1.28;
  }

  .about-content .about-text,
  .about-content .about-toolkit-lead,
  .about-content .about-formats-lead {
    line-height: 1.52;
    margin: 0;
  }

  .about-content .about-toolkit-lead,
  .about-content .about-formats-lead {
    opacity: 0.92;
  }

  .about-content .about-formats-lead {
    max-width: none;
  }

  .about-content .about-toolkit {
    margin: 0;
    padding: 0;
    border: none;
  }

  .about-toolkit-heading {
    margin: 0;
  }

  .about-toolkit-list {
    margin: 0;
    padding-inline-start: var(--px-24, 1.5rem);
    display: grid;
    gap: var(--px-8, 0.5rem);
    line-height: 1.55;
    opacity: 0.9;
  }

  .about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    align-items: start;
  }

  .about-image-wrapper {
    width: 100%;
    min-width: 0;
  }

  @media screen and (min-width: 48.0625rem) {
    .about-image-wrapper {
      margin-top: var(--px-28, 1.75rem);
    }
  }

  .about-image-wrapper :global(.about-showcase) {
    width: 100%;
  }

  .about-image-wrapper :global(.about-swiper) {
    position: relative;
    width: 100%;
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
    border: 1px solid var(--color-border-card);
    background: var(--color-surface-muted);
  }

  .about-slide {
    display: flex;
    flex-direction: column;
    gap: var(--px-12);
    padding-bottom: var(--px-4);
  }

  .about-slide-visual {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm, 4px);
  }

  .about-slide-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-slide-caption {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .about-slide-test {
    align-self: flex-start;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--transition-short);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-slide-test:hover {
      opacity: 0.75;
    }
  }

  .about-text a {
    font-weight: 500;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity var(--transition-short);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-text a:hover {
      opacity: 0.75;
    }
  }

  @media screen and (max-width: 64rem) {
    .about-container {
      gap: var(--px-32);
    }

    .about-content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-container {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .about-image-wrapper {
      order: -1;
    }
  }
</style>
