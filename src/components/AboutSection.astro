---
/**
 * Carrousel d’aperçus aligné sur la home officielle (viewer previews qui défilent).
 * https://www.itowns-project.org/
 */
import BaseSwiper from "@components/BaseSwiper.astro";
import { Image } from "astro:assets";
/** Captures de la home officielle : /assets/images/home-examples/ (copiées en local). */
import picGlobe from "/src/assets/images/home-examples/example-globe.png";
import picPlanar from "/src/assets/images/home-examples/example-planar.png";
import picVector from "/src/assets/images/home-examples/example-vector-tiles.png";
import pic3d from "/src/assets/images/home-examples/example-3d-tiles.png";
import picCopc from "/src/assets/images/home-examples/example-copc.png";
import picDsm from "/src/assets/images/home-examples/example-dsm.png";

const technologyContent = {
  title: "Technology and purpose",
  text: "iTowns is designed to help developers integrate mapping and 3D visualization in web applications, from operational GIS interfaces to digital twin experiences.",
};

const communityContent = {
  title: "Open source and community",
};

const EXAMPLES_BASE = "https://itowns.github.io/itowns/examples";

const viewerSlides = [
  {
    title: "Globe viewer",
    thumb: picGlobe,
    thumbAlt: "Picture of the example — globe viewer",
    link: `${EXAMPLES_BASE}/view_3d_map.html`,
  },
  {
    title: "Planar viewer",
    thumb: picPlanar,
    thumbAlt: "Picture of the example — planar viewer",
    link: `${EXAMPLES_BASE}/view_25d_map.html`,
  },
  {
    title: "Vector Tiles viewer",
    thumb: picVector,
    thumbAlt: "Picture of the example — vector tiles",
    link: `${EXAMPLES_BASE}/vector_tile_3d_mesh_mapbox.html`,
  },
  {
    title: "3D tiles viewer",
    thumb: pic3d,
    thumbAlt: "Picture of the example — 3D Tiles",
    link: `${EXAMPLES_BASE}/3dtiles_loader.html`,
  },
  {
    title: "Point cloud viewer",
    thumb: picCopc,
    thumbAlt: "Picture of the example — point cloud",
    link: `${EXAMPLES_BASE}/copc_simple_loader.html?copc=https%3A%2F%2Fs3.amazonaws.com%2Fhobu-lidar%2Fautzen-classified.copc.laz`,
  },
  {
    title: "Raster data viewer",
    thumb: picDsm,
    thumbAlt: "Picture of the example — raster / DSM",
    link: `${EXAMPLES_BASE}/view_3d_mns_map.html`,
  },
];
---

<section id="about" class="about">
  <div class="section-container">
    <h2 class="section-title">Build your own geographic service.</h2>

    <div class="about-container">
      <div class="about-image-wrapper">
        <BaseSwiper sliderName="about" navigation={true} pagination={true}>
          {
            viewerSlides.map((slide) => (
              <div class="swiper-slide">
                <div class="about-slide">
                  <a
                    href={slide.link}
                    class="about-slide-visual"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Image
                      src={slide.thumb}
                      alt={slide.thumbAlt}
                      width={960}
                      height={540}
                      class="media"
                      loading="lazy"
                    />
                  </a>
                  <p class="about-slide-caption">{slide.title}</p>
                  <a
                    href={slide.link}
                    class="about-slide-test"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Test the example
                  </a>
                </div>
              </div>
            ))
          }
        </BaseSwiper>
      </div>
      <div class="about-content">
        <h3 class="section-subtitle about-subtitle">{technologyContent.title}</h3>
        <p class="about-text">{technologyContent.text}</p>

        <div class="about-toolkit">
          <h3 class="section-subtitle about-toolkit-heading">
            Swiss army knife for geographic data
          </h3>
          <p class="about-toolkit-lead">
            iTowns offers a comprehensive toolkit for visualizing, interacting and
            composing diverse spatial datasets. Mix point clouds, terrain,
            orthophotos and vector data in a single view : easily extend the engine for your needs,
            build your application from simple blocks
          </p>
        </div>

        <h3 class="section-subtitle about-subtitle">{communityContent.title}</h3>
        <p class="about-text">
            iTowns is based on{" "}
            <a
                href="https://github.com/iTowns/itowns-governance"
                target="_blank"
                rel="noopener noreferrer"
                >open governance</a
            >{" "}
            that allows everyone to contribute. The project brings together developers,
            researchers, and geospatial stakeholders to evolve the framework together.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import type { Swiper } from "swiper";
  import { initSwiper } from "@utils/initSwiper";

  const SLIDER = "about";
  let instance: Swiper | null = null;

  function setupAboutSwiper() {
    instance?.destroy(true, true);
    instance = initSwiper(SLIDER, {
      autoplay: {
        delay: 4500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      pagination: {
        el: `.${SLIDER}-pagination`,
        clickable: true,
      },
      navigation: {
        prevEl: `.${SLIDER}-prev`,
        nextEl: `.${SLIDER}-next`,
      },
    });
  }

  setupAboutSwiper();
  document.addEventListener("astro:after-swap", setupAboutSwiper);
</script>

<style>
  /** Fluid heading width on small viewports. */
  .about > .section-container > .section-title {
    font-size: clamp(1rem, 0.68rem + 2.55vi, 3rem);
    line-height: 1.14;
    text-wrap: balance;
  }

  .about-content .about-toolkit {
    margin-bottom: var(--px-16, 1rem);
    padding-bottom: var(--px-20, 1.25rem);
    border-bottom: 1px solid var(--color-border-faint);
  }

  .about-toolkit-heading {
    margin-bottom: var(--px-16, 1rem);
  }

  .about-toolkit-lead {
    margin: 0 0 var(--px-20, 1.25rem);
    line-height: 1.6;
    opacity: 0.92;
  }

  .about-toolkit-lead a {
    font-weight: 500;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity var(--transition-short);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-toolkit-lead a:hover {
      opacity: 0.75;
    }
  }

  .about-toolkit-list {
    margin: 0;
    padding-inline-start: var(--px-24, 1.5rem);
    display: grid;
    gap: var(--px-8, 0.5rem);
    line-height: 1.55;
    opacity: 0.9;
  }

  .about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    align-items: start;
  }

  .about-image-wrapper {
    width: 100%;
    min-width: 0;
  }

  .about-image-wrapper :global(.about-showcase) {
    width: 100%;
  }

  .about-image-wrapper :global(.about-swiper) {
    position: relative;
    width: 100%;
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
    border: 1px solid var(--color-border-card);
    background: var(--color-surface-muted);
  }

  .about-slide {
    display: flex;
    flex-direction: column;
    gap: var(--px-12);
    padding-bottom: var(--px-4);
  }

  .about-slide-visual {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm, 4px);
  }

  .about-slide-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-slide-caption {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .about-slide-test {
    align-self: flex-start;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--transition-short);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-slide-test:hover {
      opacity: 0.75;
    }
  }

  .about-content {
    max-width: 37.5rem;
  }

  .about-text {
    margin-bottom: var(--px-32);
  }

  .about-text:last-child {
    margin-bottom: 0;
  }

  .about-text a {
    font-weight: 500;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity var(--transition-short);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-text a:hover {
      opacity: 0.75;
    }
  }

  @media screen and (max-width: 64rem) {
    .about-container {
      gap: var(--px-32);
    }

    .about-content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-container {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .about-image-wrapper {
      order: -1;
    }
  }
</style>
