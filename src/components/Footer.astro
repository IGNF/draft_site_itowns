---
import { Fragment } from "astro/jsx-runtime";
import { SITE, SOCIALS } from "@consts";
import socialIcons from "@assets/socialIcons";
import I18n from "@components/I18n.astro";

const currentYear = new Date().getFullYear();
/** Top of page (hero): hash on home, absolute link from other routes. */
const homeTopHref = Astro.url.pathname === "/" ? "#hero" : "/#hero";
---

<footer class="main-footer">
    <div class="section-container footer footer-primary">
        <div class="footer-brand">
            <a
                href={homeTopHref}
                class="headline logo"
                aria-label="iTowns showcase home"
            >
                iTowns
            </a>
            <p class="site-description">
                <I18n
                    en={SITE.DESCRIPTION}
                    fr="Avec iTowns, créez votre propre service géographique : globe, cartes planes, 3D Tiles, tuiles vectorielles, nuages de points et imagerie raster."
                />
            </p>

            <address class="footer-nav-list contact-info">
                <p class="email">
                    <span class="label"><I18n en="E." fr="E-mail" /></span>
                    <a href=`mailto:${SITE.EMAIL}`>{SITE.EMAIL}</a>
                </p>
            </address>
        </div>

        <nav class="footer-navigation" aria-labelledby="footer-nav-title">
            <span id="footer-nav-title" class="sr-only">
                <I18n
                    en="Footer navigation"
                    fr="Navigation de pied de page"
                />
            </span>
            <div class="footer-nav-section">
                <h2 class="headline footer-heading">
                    <I18n en="Navigation" fr="Navigation" />
                </h2>
                <ul class="footer-nav-list">
                    <li>
                        <a href="#hero" class="footer-link"
                            ><I18n en="Home" fr="Accueil" /></a
                        >
                    </li>
                    <li>
                        <a href="#about" class="footer-link"
                            ><I18n
                                en="About iTowns"
                                fr="À propos d'iTowns"
                            /></a
                        >
                    </li>
                    <li>
                        <a href="#fundamentals" class="footer-link"
                            ><I18n en="Fundamentals" fr="Fondamentaux" /></a
                        >
                    </li>
                    <li>
                        <a href="#portfolio" class="footer-link"
                            ><I18n en="Viewers" fr="Visionneuses" /></a
                        >
                    </li>
                    <li>
                        <a href="#license" class="footer-link"
                            ><I18n en="License" fr="Licence" /></a
                        >
                    </li>
                    <li>
                        <a href="#faq" class="footer-link">FAQ</a>
                    </li>
                    <li>
                        <a href="#governance" class="footer-link"
                            ><I18n en="Governance" fr="Gouvernance" /></a
                        >
                    </li>
                    <li>
                        <a href={`mailto:${SITE.EMAIL}`} class="footer-link"
                            ><I18n en="Contact" fr="Contact" /></a
                        >
                    </li>
                </ul>
            </div>

            <div class="footer-nav-section">
                <h2 class="headline footer-heading">
                    <I18n en="Community" fr="Communauté" />
                </h2>
                <ul class="footer-nav-list social-links-list">
                    <li class="social-item">
                        <a
                            href="https://github.com/iTowns/itowns-governance/tree/New-governance-proposal"
                            class="footer-link social-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            data-aria-en="iTowns governance on GitHub"
                            data-aria-fr="Gouvernance iTowns sur GitHub"
                            aria-label="iTowns governance on GitHub"
                        >
                            <Fragment set:html={socialIcons.github} />
                            <I18n en="Governance" fr="Gouvernance" />
                        </a>
                    </li>
                    {
                        SOCIALS.map((social) => (
                            <>
                                <li class="social-item">
                                    <a
                                        href={social.HREF}
                                        class="footer-link social-link"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        data-aria-en={social.LABEL}
                                        data-aria-fr={
                                            social.LABEL_FR ?? social.LABEL
                                        }
                                        aria-label={social.LABEL}
                                    >
                                        <Fragment
                                            set:html={socialIcons[social.ICON]}
                                        />
                                        {social.NAME}
                                    </a>
                                </li>
                            </>
                        ))
                    }
                </ul>
            </div>
        </nav>
    </div>

    <div class="footer footer-secondary">
        <div class="copyright">
            <p>
                <span class="i18n-en"
                    >&copy; {SITE.COMPANY_NAME} {currentYear}.</span
                >
                <span class="i18n-fr"
                    >&copy; {SITE.COMPANY_NAME} {currentYear}. Tous droits réservés.</span
                >
            </p>
        </div>
    </div>
</footer>

<style>
    a {
        transition: all var(--transition-short);
    }

    a:active {
        color: var(--color-text-primary);
    }

    .main-footer {
        background-color: var(--color-background);
        padding-block: var(--px-112) var(--px-28);
        padding-inline: var(--px-64);
        color: var(--color-text-dark);
        font-size: var(--text-sm);
    }

    .footer {
        display: flex;
        justify-content: space-between;
    }

    .headline {
        color: var(--color-text-primary);
    }

    .main-footer p {
        opacity: 1;
    }

    .footer-primary {
        margin-bottom: var(--px-112);
    }

    .logo {
        display: inline-block;
        margin-bottom: var(--px-28);
        font-size: var(--text-xl);
        font-weight: 700;
    }

    .site-description {
        margin-bottom: var(--px-32);
    }

    .footer-navigation {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        justify-content: space-between;
        width: 100%;
        margin-left: 16%;
        gap: var(--px-96);
    }

    .footer-heading {
        margin-bottom: var(--px-16);
        font-size: var(--text-lg);
        letter-spacing: -0.02em;
        font-weight: 500;
        text-wrap: nowrap;
    }

    .footer-nav-list {
        display: inline-flex;
        flex-direction: column;
        font-size: var(--text-sm);
        gap: var(--px-8);
        text-wrap: nowrap;
    }

    .social-link {
        display: flex;
        align-items: center;
        gap: var(--px-6);
    }

    .social-link :global(svg) {
        height: var(--px-18);
    }

    .contact-info {
        font-style: normal;
    }

    .footer-secondary {
        font-weight: 500;
    }

    @media (hover: hover) and (pointer: fine) {
        a:hover {
            color: var(--color-text-primary);
        }
    }

    @media screen and (max-width: 64rem) {
        .main-footer {
            padding-top: var(--px-80);
            padding-inline: var(--px-28);
        }

        .footer {
            flex-wrap: wrap;
            gap: var(--px-48);
        }

        .footer-navigation {
            margin-left: 0;
            width: auto;
        }

        .footer-primary {
            margin-bottom: var(--px-80);
        }
    }

    @media screen and (max-width: 37.5rem) {
        .main-footer {
            padding-top: var(--px-64);
        }

        .footer-navigation {
            grid-template-columns: 1fr;
            width: 100%;
            gap: var(--px-28);
        }

        .footer-secondary {
            gap: var(--px-6) var(--px-48);
        }

        .footer-primary {
            margin-bottom: var(--px-48);
        }
    }
</style>
