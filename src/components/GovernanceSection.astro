---
/**
 * Résumé aligné sur :
 * https://github.com/iTowns/itowns-governance/tree/New-governance-proposal
 */
import I18n from "@components/I18n.astro";
import { governanceCopy } from "@i18n/copy/governance";

const GOVERNANCE_URL =
    "https://github.com/iTowns/itowns-governance/tree/New-governance-proposal";
const PROPOSAL_URL =
    "https://github.com/iTowns/itowns-governance/blob/New-governance-proposal/proposal.md";
const MEMBERSHIP_URL =
    "https://github.com/iTowns/itowns-governance/blob/New-governance-proposal/membership.md";
---

<section id="governance" class="governance">
    <div class="section-container">
        <h2 class="section-title"><I18n t={governanceCopy.sectionTitle} /></h2>
        <p class="governance-lead"><I18n t={governanceCopy.lead} /></p>

        <div class="governance-grid">
            {
                governanceCopy.blocks.map((block) => (
                    <article class="governance-card">
                        <h3 class="section-subtitle governance-card-title">
                            <I18n t={block.title} />
                        </h3>
                        {block.text && (
                            <p class="governance-card-text">
                                <I18n t={block.text} />
                            </p>
                        )}
                        {block.items && (
                            <ul class="governance-list">
                                {block.items.map((item) => (
                                    <li>
                                        <I18n t={item} />
                                    </li>
                                ))}
                            </ul>
                        )}
                    </article>
                ))
            }
        </div>

        <nav class="governance-links" aria-label="Governance resources">
            <a
                href={GOVERNANCE_URL}
                target="_blank"
                rel="noopener noreferrer"
                ><I18n t={governanceCopy.readMore} /></a
            >
            <a
                href={PROPOSAL_URL}
                target="_blank"
                rel="noopener noreferrer"
                ><I18n t={governanceCopy.proposeChanges} /></a
            >
            <a
                href={MEMBERSHIP_URL}
                target="_blank"
                rel="noopener noreferrer"
                ><span class="i18n-en">PSC membership</span><span
                    class="i18n-fr">Membres du PSC</span
                ></a
            >
        </nav>
    </div>
</section>

<style>
    .governance-lead {
        max-width: 52rem;
        margin: calc(var(--px-64, 4rem) * -0.35) 0 var(--px-40, 2.5rem);
        line-height: 1.55;
        opacity: 0.92;
    }

    .governance-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--px-24, 1.5rem);
    }

    .governance-card {
        border: 1px solid var(--color-border-card);
        border-radius: 0.75rem;
        padding: var(--px-28, 1.75rem);
        background: var(--color-surface-muted);
    }

    .governance-card-title {
        margin: 0 0 var(--px-12, 0.75rem);
        font-size: clamp(1rem, 0.92rem + 0.35vi, var(--text-lg));
        line-height: 1.28;
    }

    .governance-card-text {
        margin: 0;
        line-height: 1.55;
        font-size: clamp(0.875rem, 0.82rem + 0.2vi, 0.9375rem);
        opacity: 0.92;
    }

    .governance-list {
        margin: 0;
        padding-left: 1.25rem;
        line-height: 1.5;
        font-size: clamp(0.875rem, 0.82rem + 0.2vi, 0.9375rem);
    }

    .governance-list li {
        margin-bottom: var(--px-6, 0.375rem);
        opacity: 0.92;
    }

    .governance-card-text + .governance-list,
    .governance-list + .governance-card-text {
        margin-top: var(--px-12, 0.75rem);
    }

    .governance-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--px-16, 1rem) var(--px-28, 1.75rem);
        margin-top: var(--px-32, 2rem);
        font-size: var(--text-sm, 0.875rem);
    }

    .governance-links a {
        font-weight: 500;
        border-bottom: 2px solid currentColor;
        padding-bottom: 2px;
        transition: opacity var(--transition-short, 0.15s) ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .governance-links a:hover {
            opacity: 0.75;
        }
    }

    @media screen and (max-width: 48rem) {
        .governance-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
