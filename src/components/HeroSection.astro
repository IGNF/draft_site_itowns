---
/** Globe matching view_3d_map (ortho + elevation), no GUI — see /public/itowns-globe-minimal.html */
import I18n from "@components/I18n.astro";

const heroExampleUrl = `${import.meta.env.BASE_URL}itowns-globe-minimal.html`;
---

<section id="hero" class="hero">
    <div class="section-container hero-container">
        <div class="hero-content">
            <h1 class="hero-title">
                <I18n
                    en="Visualising 3D geospatial data with iTowns."
                    fr="Visualiser des données géospatiales 3D avec iTowns."
                />
            </h1>
            <p class="hero-subtitle">
                <I18n
                    en="Build your own 3D geographic service with an open-source framework designed for globe and planar visualization on the web."
                    fr="Créez votre propre service géographique 3D avec une bibliothèque open source pensée pour la visualisation globe ou plane sur le web."
                />
            </p>
            <div class="hero-cta">
                <a
                    href="https://github.com/Desplandis/itowns-starter-webpack"
                    class="btn btn--primary"
                    target="_blank"
                    rel="noopener noreferrer"
                    ><I18n
                        en="START A NEW PROJECT"
                        fr="DÉMARRER UN PROJET"
                    /></a
                >
                <a
                    href="https://github.com/iTowns/iTowns"
                    class="btns--secondary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="btn--secondary btn--secondary-unhovered">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 384 512"
                            ><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
                            <path
                                fill="currentColor"
                                d="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80L0 432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z"
                            ></path>
                        </svg>
                        <I18n
                            en="Explore Code Source"
                            fr="Explorer le code source"
                        />
                    </span>
                    <span
                        class="btn--secondary btn--secondary-hovered"
                        aria-hidden="true"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 384 512"
                            ><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
                            <path
                                fill="currentColor"
                                d="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80L0 432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z"
                            ></path>
                        </svg>
                        <I18n
                            en="Explore Code Source"
                            fr="Explorer le code source"
                        />
                    </span>
                </a>
            </div>
        </div>
        <div class="hero-globe-slot">
            <div class="hero-globe-spacer" aria-hidden="true"></div>
            <div class="video-wrapper hero-view-only hero-globe-track" data-hero-globe>
                <div class="globe-frame-shell">
                    <iframe
                        src={heroExampleUrl}
                        title="Globe iTowns — ortho et relief, sans interface (iTowns globe — ortho and elevation, no UI)"
                        class="globe-iframe"
                        loading="eager"
                        referrerpolicy="strict-origin-when-cross-origin"
                        sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-popups"
                        allow="fullscreen"
                    ></iframe>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function smoothstep01(t: number): number {
        const x = Math.min(1, Math.max(0, t));
        return x * x * (3 - 2 * x);
    }

    function getScrollRoot(): HTMLElement | null {
        return document.getElementById("page-scroll");
    }

    function getScrollY(): number {
        const root = getScrollRoot();
        return root != null ? root.scrollTop : window.scrollY;
    }

    function updateHeroGlobeScroll(): void {
        const globe = document.querySelector("[data-hero-globe]");
        if (!(globe instanceof HTMLElement)) return;

        const scrollY = getScrollY();
        const vh = window.innerHeight;

        /** Initial hero fade (~1.25× viewport height, min 520px). */
        const heroFadeSpan = Math.max(vh * 1.25, 520);

        const opacity =
            scrollY < heroFadeSpan
                ? 1 - smoothstep01(scrollY / heroFadeSpan)
                : 0;

        globe.style.setProperty("--hero-globe-opacity", String(opacity));
        globe.style.pointerEvents = opacity < 0.04 ? "none" : "";
    }

    function onScroll(): void {
        requestAnimationFrame(updateHeroGlobeScroll);
    }

    updateHeroGlobeScroll();
    requestAnimationFrame(() => {
        const scrollTarget = document.getElementById("page-scroll") ?? window;
        scrollTarget.addEventListener("scroll", onScroll, { passive: true });
    });
    window.addEventListener("resize", onScroll, { passive: true });
    document.addEventListener("astro:after-swap", updateHeroGlobeScroll);
</script>

<style>
    .hero {
        min-height: 100vh;
        /* #page-scroll commence déjà sous le menu : ne pas cumuler l’ancien décalage “sous header” */
        padding-block: max(var(--px-24), calc(6.688rem - var(--h-menu-bar)))
            var(--px-56);
        display: flex;
        align-items: center;
    }

    .hero-container {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        align-items: center;
    }

    .hero-content {
        max-width: 37.5rem;
    }

    .hero-title {
        margin-bottom: var(--px-28);
        font-size: clamp(2.125rem, 6vw, var(--text-xxl));
        font-weight: 500;
        line-height: 1.2;
    }

    .hero-subtitle {
        font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
        margin-bottom: var(--px-48);
        line-height: 1.5;
    }

    .hero-cta {
        display: flex;
        gap: var(--px-16) var(--px-48);
        flex-wrap: wrap;
    }

    .btns--secondary {
        font-weight: 500;
        margin-top: 0.438rem;
        height: var(--px-36);
    }

    .btn--secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--px-8);
    }

    .btn--secondary svg {
        height: var(--px-16);
    }

    .video-wrapper {
        width: 100%;
        height: 100%;
    }

    .hero-view-only {
        min-width: 0;
    }

    .hero-globe-slot {
        min-width: 0;
        align-self: center;
    }

    .hero-globe-spacer {
        display: none;
    }

    .hero-globe-track {
        opacity: var(--hero-globe-opacity, 1);
    }

    .globe-frame-shell {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 11;
        min-height: clamp(14rem, 58vh, 36rem);
        border-radius: 0.75rem;
        overflow: hidden;
        background: var(--color-globe-shell);
        box-shadow:
            0 4px 24px var(--color-globe-shell-outer-shadow),
            inset 0 0 0 1px var(--color-globe-shell-highlight);
    }

    .globe-iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: none;
        display: block;
    }

    @media screen and (max-width: 64rem) {
        .hero-container {
            gap: var(--px-32);
        }

        .hero-content {
            max-width: 100%;
        }

        .hero-title {
            line-height: 1.3;
        }
    }

    @media screen and (min-width: 59.376rem) {
        .hero-globe-spacer {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 11;
            min-height: clamp(14rem, 58vh, 36rem);
            visibility: hidden;
            pointer-events: none;
        }

        .hero-globe-track {
            position: fixed;
            top: max(7.75rem, 16vh);
            right: max(var(--px-28), calc((100vw - min(90rem, 100vw)) / 2 + var(--px-64)));
            width: min(37.5rem, calc((min(90rem, 100vw) - var(--px-64) * 2 - var(--px-64)) / 2));
            z-index: 0;
            max-width: calc(50vw - var(--px-48));
            transform: translateX(var(--px-8));
        }
    }

    @media screen and (max-width: 59.375rem) {
        .hero {
            min-height: auto;
        }

        .hero-container {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .hero-title {
            margin-bottom: var(--px-24);
        }

        .hero-subtitle {
            margin-bottom: var(--px-36);
        }

        .hero-cta {
            column-gap: var(--px-32);
        }

        .hero-globe-track {
            position: relative;
            top: auto;
            right: auto;
            width: 100%;
            max-width: none;
        }

        .globe-frame-shell {
            min-height: clamp(12rem, 45vh, 28rem);
        }
    }
</style>
