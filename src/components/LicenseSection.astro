---
/**
 * Contenu aligné sur la page officielle :
 * https://www.itowns-project.org/about#license
 */
const itownsLicenseUrl =
    "https://github.com/iTowns/iTowns/blob/master/LICENSE.md";

const thirdParty = [
    { name: "Three", note: "MIT (Three.js license)" },
    { name: "proj4", note: "MIT" },
    { name: "@mapbox/mapbox-gl-style-spec", note: "ISC" },
    { name: "@mapbox/vector-tile", note: "BSD-3-Clause" },
    { name: "@tmcw/togeojson", note: "BSD-3-Clause" },
    { name: "@tweenjs/tween.js", note: "MIT" },
    { name: "earcut", note: "ISC" },
    { name: "js-priority-queue", note: "Public Domain" },
    { name: "pbf", note: "BSD-3-Clause" },
    { name: "shpjs", note: "MIT" },
];
---

<section id="license" class="license">
    <div class="section-container">
        <h2 class="section-title">License</h2>
        <p class="license-lead">
            iTowns is distributed under permissive terms: you may use, modify,
            publish, and sell the code, provided you retain the license and
            copyright notices when you share it.
        </p>

        <div class="license-block">
            <h3 class="section-subtitle license-block-title">iTowns</h3>
            <p class="license-text">
                Full modification and redistribution rights, with citation
                requirements and community rules as defined in the project
                license (MIT / dual licensing with CeCILL B as applicable).
            </p>
            <ul class="license-links">
                <li>
                    <a
                        href={itownsLicenseUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        >iTowns <code>LICENSE.md</code> on GitHub</a
                    >
                </li>
                <li>
                    <a
                        href="https://opensource.org/license/mit/"
                        target="_blank"
                        rel="noopener noreferrer"
                        >MIT License</a
                    >
                </li>
                <li>
                    <a
                        href="https://cecill.info/"
                        target="_blank"
                        rel="noopener noreferrer"
                        >CeCILL B</a
                    >
                </li>
            </ul>
        </div>

        <div class="license-block license-block--third-party">
            <h3 class="section-subtitle license-block-title">Third-party code</h3>
            <p class="license-text">
                iTowns bundles or references several libraries; each carries its
                own license. Non-exhaustive list:
            </p>
            <ul class="third-party-list third-party-list--single-line">
                {
                    thirdParty.map((item) => (
                        <li class="third-party-item">
                            <span class="third-party-name">{item.name}</span>
                            <span class="third-party-sep" aria-hidden="true">
                                —
                            </span>
                            <span class="third-party-note">{item.note}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style>
    .license {
        padding-block: var(--px-80, 5rem);
    }

    .license-lead {
        max-width: 52rem;
        margin-bottom: var(--px-32, 2rem);
        line-height: 1.55;
        opacity: 0.92;
    }

    .license-block {
        margin-top: var(--px-40, 2.5rem);
        border: 1px solid var(--color-border-card);
        border-radius: 0.75rem;
        padding: var(--px-28, 1.75rem);
    }

    .license-block--third-party {
        margin-top: var(--px-24, 1.5rem);
    }

    .license-block-title {
        margin: 0 0 var(--px-16, 1rem);
    }

    .license-text {
        margin: 0 0 var(--px-20, 1.25rem);
        line-height: 1.55;
        max-width: 52rem;
    }

    .license-links {
        margin: 0;
        padding-left: 1.25rem;
        line-height: 1.7;
    }

    .license-links a {
        border-bottom: 2px solid currentColor;
        padding-bottom: 2px;
        transition: opacity var(--transition-short, 0.15s ease);
    }

    @media (hover: hover) and (pointer: fine) {
        .license-links a:hover {
            opacity: 0.75;
        }
    }

    .license-links code {
        font-size: 0.92em;
    }

    .third-party-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .third-party-list--single-line {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: baseline;
        gap: 0;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        padding-bottom: var(--px-4, 0.25rem);
    }

    .third-party-item {
        display: flex;
        flex-wrap: nowrap;
        flex-shrink: 0;
        align-items: baseline;
        gap: 0.35rem;
        white-space: nowrap;
    }

    .third-party-item:not(:first-child)::before {
        content: "·";
        margin: 0 0.5rem 0 0.35rem;
        opacity: 0.45;
        flex-shrink: 0;
    }

    .third-party-name {
        font-family: ui-monospace, monospace;
        font-size: var(--text-sm, 0.875rem);
        font-weight: 500;
    }

    .third-party-sep {
        opacity: 0.45;
    }

    .third-party-note {
        font-size: var(--text-sm, 0.875rem);
        opacity: 0.8;
    }
</style>
