---
/**
 * Contenu aligné sur la page officielle :
 * https://www.itowns-project.org/about#license
 */
import I18n from "@components/I18n.astro";
import { licenseCopy } from "@i18n/copy/license";

const ITOWNS_LICENSE_URL =
    "https://github.com/iTowns/iTowns/blob/master/LICENSE.md";
---

<section id="license" class="license">
    <div class="section-container">
        <h2 class="section-title"><I18n t={licenseCopy.sectionTitle} /></h2>
        <p class="license-lead"><I18n t={licenseCopy.lead} /></p>

        <div class="license-block">
            <h3 class="section-subtitle license-block-title">iTowns</h3>
            <p class="license-text"><I18n t={licenseCopy.blockText} /></p>
            <ul class="license-links">
                <li>
                    <a
                        href={ITOWNS_LICENSE_URL}
                        target="_blank"
                        rel="noopener noreferrer"
                        ><span class="i18n-en"
                            >iTowns <code>LICENSE.md</code> on GitHub</span
                        ><span class="i18n-fr"
                            ><code>LICENSE.md</code> iTowns sur GitHub</span
                        ></a
                    >
                </li>
                <li>
                    <a
                        href="https://opensource.org/license/mit/"
                        target="_blank"
                        rel="noopener noreferrer"
                        ><I18n t={licenseCopy.mit} /></a
                    >
                </li>
                <li>
                    <a
                        href="https://cecill.info/"
                        target="_blank"
                        rel="noopener noreferrer"
                        >CeCILL B</a
                    >
                </li>
            </ul>
        </div>
    </div>
</section>

<style>
    .license {
        padding-block: var(--px-80, 5rem);
    }

    .license-lead {
        max-width: 52rem;
        margin-bottom: var(--px-32, 2rem);
        line-height: 1.55;
        opacity: 0.92;
    }

    .license-block {
        margin-top: var(--px-40, 2.5rem);
        border: 1px solid var(--color-border-card);
        border-radius: 0.75rem;
        padding: var(--px-28, 1.75rem);
    }

    .license-block-title {
        margin: 0 0 var(--px-16, 1rem);
    }

    .license-text {
        margin: 0 0 var(--px-20, 1.25rem);
        line-height: 1.55;
        max-width: 52rem;
    }

    .license-links {
        margin: 0;
        padding-left: 1.25rem;
        line-height: 1.7;
    }

    .license-links a {
        border-bottom: 2px solid currentColor;
        padding-bottom: 2px;
        transition: opacity var(--transition-short, 0.15s) ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .license-links a:hover {
            opacity: 0.75;
        }
    }

    .license-links code {
        font-size: 0.92em;
    }
</style>
