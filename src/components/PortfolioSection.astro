---
import { Image } from "astro:assets";
import I18n from "@components/I18n.astro";
import { viewerExamples } from "@data/viewerExamples";
import { portfolioCopy } from "@i18n/copy/portfolio";
import { bilingualImageAlt } from "@i18n/types";
---

<section id="portfolio" class="portfolio">
    <div class="section-container">
        <h2 class="section-title"><I18n t={portfolioCopy.sectionTitle} /></h2>
        <div class="viewer-grid">
            {
                viewerExamples.map((example) => (
                    <article class="viewer-card">
                        <div class="viewer-thumb">
                            <Image
                                src={example.thumb}
                                alt={bilingualImageAlt(example.thumbAlt)}
                                width={640}
                                height={360}
                                class="media"
                                loading="lazy"
                            />
                        </div>
                        <h3 class="section-subtitle info-title">
                            <I18n t={example.title} />
                        </h3>
                        <p class="info-text">
                            <I18n t={example.description} />
                        </p>
                        <a
                            class="btn--secondary view-details"
                            href={example.link}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <I18n t={portfolioCopy.openExample} />
                        </a>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .viewer-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--px-24);
    }

    .viewer-card {
        border: 1px solid var(--color-border-card);
        padding: var(--px-24);
        display: grid;
        gap: var(--px-12);
    }

    .viewer-thumb {
        border-radius: var(--radius-md, 0.5rem);
        overflow: hidden;
        background: var(--color-surface-muted);
    }

    .viewer-thumb :global(.media) {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
    }

    .info-title {
        margin-bottom: 0;
    }

    .view-details {
        display: inline-flex;
        font-weight: 500;
        margin-top: auto;
    }

    .btn--secondary {
        border-bottom: var(--px-2) solid currentColor;
    }

    @media screen and (max-width: 64rem) {
        .viewer-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media screen and (max-width: 48rem) {
        .viewer-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
