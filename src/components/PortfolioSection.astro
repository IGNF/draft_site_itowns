---
import { Image } from "astro:assets";
/** Images de la home officielle (copiées depuis itowns-project.org). */
import picGlobe from "/src/assets/images/home-examples/example-globe.png";
import picPlanar from "/src/assets/images/home-examples/example-planar.png";
import picVector from "/src/assets/images/home-examples/example-vector-tiles.png";
import pic3d from "/src/assets/images/home-examples/example-3d-tiles.png";
import picCopc from "/src/assets/images/home-examples/example-copc.png";
import picDsm from "/src/assets/images/home-examples/example-dsm.png";

const EXAMPLES_BASE = "https://itowns.github.io/itowns/examples";

const viewers = [
    {
        title: "Globe viewer",
        description:
            "Visualize data in a global reference coordinates system.",
        link: `${EXAMPLES_BASE}/view_3d_map.html`,
        thumb: picGlobe,
        thumbAlt: "Picture of the example — globe viewer",
    },
    {
        title: "Planar viewer",
        description:
            "Visualize data in a local projected Coordinates Reference System. Here, we display data in RGF93/Lambert93 CRS.",
        link: `${EXAMPLES_BASE}/view_25d_map.html`,
        thumb: picPlanar,
        thumbAlt: "Picture of the example — planar viewer",
    },
    {
        title: "Vector tiles viewer",
        description:
            "Visualize Vector Tiles data. Here we display polygons for the holds of buildings and extrude them, their height being extracted from data.",
        link: `${EXAMPLES_BASE}/vector_tile_3d_mesh_mapbox.html`,
        thumb: picVector,
        thumbAlt: "Picture of the example — vector tiles",
    },
    {
        title: "3D tiles viewer",
        description:
            "Visualize 3D Tiles data. Here we display some batched 3d model.",
        link: `${EXAMPLES_BASE}/3dtiles_loader.html`,
        thumb: pic3d,
        thumbAlt: "Picture of the example — 3D Tiles",
    },
    {
        title: "Point cloud viewer",
        description:
            "Visualize point cloud data and style it as you wish. Here we display COPC data colored from its classification.",
        link: `${EXAMPLES_BASE}/copc_simple_loader.html?copc=https%3A%2F%2Fs3.amazonaws.com%2Fhobu-lidar%2Fautzen-classified.copc.laz`,
        thumb: picCopc,
        thumbAlt: "Picture of the example — point cloud",
    },
    {
        title: "Raster data viewer",
        description:
            "Visualize raster data. Here we display some ortho-images as well as a Digital Surface Model.",
        link: `${EXAMPLES_BASE}/view_3d_mns_map.html`,
        thumb: picDsm,
        thumbAlt: "Picture of the example — raster / DSM",
    },
];
---

<section id="portfolio" class="portfolio">
    <div class="section-container">
        <h2 class="section-title">What can be done with iTowns ?</h2>
        <div class="viewer-grid">
            {
                viewers.map((viewer) => (
                    <article class="viewer-card">
                        <div class="viewer-thumb">
                            <Image
                                src={viewer.thumb}
                                alt={viewer.thumbAlt}
                                width={640}
                                height={360}
                                class="media"
                                loading="lazy"
                            />
                        </div>
                        <h3 class="section-subtitle info-title">{viewer.title}</h3>
                        <p class="info-text">{viewer.description}</p>
                        <a
                            class="btn--secondary view-details"
                            href={viewer.link}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Open example
                        </a>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .viewer-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--px-24);
    }

    .viewer-card {
        border: 1px solid var(--color-border-card);
        padding: var(--px-24);
        display: grid;
        gap: var(--px-12);
    }

    .viewer-thumb {
        border-radius: var(--radius-md, 0.5rem);
        overflow: hidden;
        background: var(--color-surface-muted);
    }

    .viewer-thumb :global(.media) {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
    }

    .info-title {
        margin-bottom: 0;
    }

    .view-details {
        display: inline-flex;
        font-weight: 500;
        margin-top: auto;
    }

    .btn--secondary {
        border-bottom: var(--px-2) solid currentColor;
    }

    @media screen and (max-width: 64rem) {
        .viewer-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media screen and (max-width: 48rem) {
        .viewer-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
