---
import "@styles/_variables.css";
import "@styles/_reset.css";
import "@styles/global.css";
import "@styles/i18n.css";

import { Font } from "astro:assets";
import { SITE, SOCIALS } from "@consts";
import { ClientRouter } from "astro:transitions";
import Header from "components/Header.astro";
import Footer from "@components/Footer.astro";
import I18n from "@components/I18n.astro";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const {
    companyName = SITE.COMPANY_NAME,
    legalName = SITE.LEGAL_NAME,
    title = `${SITE.COMPANY_NAME}: ${SITE.TITLE}`,
    description = SITE.DESCRIPTION,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    ogImage = SITE.OG_IMAGE,
    twitterHandle = SITE.TWITTER?.CREATOR,
} = Astro.props;

const ogRel = (ogImage ?? SITE.OG_IMAGE ?? "og-image.webp").replace(/^\//, "");
const socialImageURL = new URL(
    `${import.meta.env.BASE_URL}${ogRel}`,
    Astro.url.origin,
).href;

const schemaData = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `${title}`,
    url: `${canonicalURL}`,
    description: `${description}`,
    isPartOf: {
        "@type": "WebSite",
        name: `${companyName}`,
        url: `${canonicalURL}`,
        publisher: {
            "@type": "Organization",
            name: `${companyName}`,
            legalName: legalName,
            url: `${canonicalURL}`,
            "@id": `${canonicalURL}`,
            sameAs: SOCIALS.map((social) => social.HREF),
        },
    },
};
---

<!doctype html>
<html lang={`${SITE.LOCALE ?? "en"}`} data-theme="dark" data-lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="theme-color"
            content="#0f0f0f"
            id="meta-theme-color"
        />
        <script is:inline>
            (function () {
                try {
                    var themeKey = "itowns-theme";
                    var langKey = "itowns-lang";
                    var ts = localStorage.getItem(themeKey);
                    var isDark =
                        ts === "light" ? false : ts === "dark" ? true : true;
                    document.documentElement.dataset.theme = isDark
                        ? "dark"
                        : "light";
                    var meta = document.getElementById("meta-theme-color");
                    if (meta) {
                        meta.setAttribute(
                            "content",
                            isDark ? "#0f0f0f" : "#f1f1f1",
                        );
                    }
                    var ls = localStorage.getItem(langKey);
                    var lang = ls === "fr" || ls === "en" ? ls : "en";
                    document.documentElement.dataset.lang = lang;
                    document.documentElement.setAttribute("lang", lang);
                } catch (e) {
                    document.documentElement.dataset.theme = "dark";
                    document.documentElement.dataset.lang = "en";
                    document.documentElement.setAttribute("lang", "en");
                    var meta = document.getElementById("meta-theme-color");
                    if (meta) meta.setAttribute("content", "#0f0f0f");
                }
            })();
        </script>
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.BASE_URL}favicon.svg`}
        />
        <link rel="canonical" href={canonicalURL} />
        <!-- Preload fonts -->
        <Font cssVariable="--font-dm-sans" />

        <meta name="generator" content={Astro.generator} />

        <ClientRouter />

        <!-- General Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content={legalName} />
        <link
            rel="sitemap"
            href={`${import.meta.env.BASE_URL}sitemap-index.xml`}
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content={SITE.TWITTER?.CARD} />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />
        {
            twitterHandle && (
                <meta property="twitter:creator" content={twitterHandle} />
            )
        }

        <!-- Google JSON-LD Structured data -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(schemaData)}
        />

        {
            // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
            // include google-site-verification tag in the heading
            // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
            googleSiteVerification && (
                <meta
                    name="google-site-verification"
                    content={googleSiteVerification}
                />
            )
        }
    </head>
    <body>
        <a href="#main" class="skip-link"><I18n t={{ en: "Skip to content", fr: "Aller au contenu" }} /></a>

        <Header />
        <div id="page-scroll" class="page-scroll">
            <div id="trigger" class="trigger" aria-hidden="true"></div>
            <main id="main" tabindex="-1">
                <slot />
            </main>
            <Footer />
        </div>

        <script>
            import "@scripts/site-ui";
        </script>
    </body>
</html>

<style>
    .skip-link {
        position: absolute;
        top: var(--px-10);
        left: var(--px-8);
        transform: translateY(-200%);
        padding: var(--px-12) var(--px-16);
        border-radius: var(--px-6);
        color: var(--color-white);
        background: var(--color-primary);
        z-index: 1001;
        opacity: 0;
        transition: opacity var(--transition-short);
    }

    .skip-link:focus-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>
