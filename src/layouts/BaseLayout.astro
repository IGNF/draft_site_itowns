---
import "@styles/_variables.css";
import "@styles/_reset.css";
import "@styles/global.css";
import "@styles/i18n.css";

import { Font } from "astro:assets";
import { SITE, SOCIALS } from "@consts";
import { ClientRouter } from "astro:transitions";
import Header from "components/Header.astro";
import Footer from "@components/Footer.astro";
import I18n from "@components/I18n.astro";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const {
    companyName = SITE.COMPANY_NAME,
    legalName = SITE.LEGAL_NAME,
    title = `${SITE.COMPANY_NAME}: ${SITE.TITLE}`,
    description = SITE.DESCRIPTION,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    ogImage = SITE.OG_IMAGE,
    twitterHandle = SITE.TWITTER?.CREATOR,
} = Astro.props;

const ogRel = (ogImage ?? SITE.OG_IMAGE ?? "og-image.webp").replace(/^\//, "");
const socialImageURL = new URL(
    `${import.meta.env.BASE_URL}${ogRel}`,
    Astro.url.origin,
).href;

const schemaData = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `${title}`,
    url: `${canonicalURL}`,
    description: `${description}`,
    isPartOf: {
        "@type": "WebSite",
        name: `${companyName}`,
        url: `${canonicalURL}`,
        publisher: {
            "@type": "Organization",
            name: `${companyName}`,
            legalName: legalName,
            url: `${canonicalURL}`,
            "@id": `${canonicalURL}`,
            sameAs: SOCIALS.map((social) => social.HREF),
        },
    },
};
---

<!doctype html>
<html lang={`${SITE.LOCALE ?? "en"}`} data-theme="dark" data-lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="theme-color"
            content="#0f0f0f"
            id="meta-theme-color"
        />
        <script is:inline>
            (function () {
                try {
                    var k = "itowns-theme";
                    var s = localStorage.getItem(k);
                    /* Défaut : sombre. "light" / "dark" explicites uniquement. */
                    var isDark =
                        s === "light" ? false : s === "dark" ? true : true;
                    document.documentElement.dataset.theme = isDark
                        ? "dark"
                        : "light";
                    var meta = document.getElementById("meta-theme-color");
                    if (meta) {
                        meta.setAttribute(
                            "content",
                            isDark ? "#0f0f0f" : "#f1f1f1",
                        );
                    }
                } catch (e) {
                    document.documentElement.dataset.theme = "dark";
                    var meta = document.getElementById("meta-theme-color");
                    if (meta) meta.setAttribute("content", "#0f0f0f");
                }
            })();
        </script>
        <script is:inline>
            (function () {
                try {
                    var k = "itowns-lang";
                    var s = localStorage.getItem(k);
                    if (s !== "fr" && s !== "en") s = "en";
                    document.documentElement.dataset.lang = s;
                    document.documentElement.setAttribute("lang", s);
                } catch (e) {
                    document.documentElement.dataset.lang = "en";
                    document.documentElement.setAttribute("lang", "en");
                }
            })();
        </script>
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.BASE_URL}favicon.svg`}
        />
        <link rel="canonical" href={canonicalURL} />
        <!-- Preload fonts -->
        <Font cssVariable="--font-dm-sans" />

        <meta name="generator" content={Astro.generator} />

        <ClientRouter />

        <!-- General Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content={legalName} />
        <link
            rel="sitemap"
            href={`${import.meta.env.BASE_URL}sitemap-index.xml`}
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content={SITE.TWITTER?.CARD} />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />
        {
            twitterHandle && (
                <meta property="twitter:creator" content={twitterHandle} />
            )
        }

        <!-- Google JSON-LD Structured data -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(schemaData)}
        />

        {
            // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
            // include google-site-verification tag in the heading
            // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
            googleSiteVerification && (
                <meta
                    name="google-site-verification"
                    content={googleSiteVerification}
                />
            )
        }
    </head>
    <body>
        <a href="#main" class="skip-link"
            ><I18n en="Skip to content" fr="Aller au contenu" /></a
        >

        <Header />
        <div id="page-scroll" class="page-scroll">
            <div id="trigger" class="trigger" aria-hidden="true"></div>
            <main id="main" tabindex="-1">
                <slot />
            </main>
            <Footer />
        </div>

        <script is:inline>
            (function () {
                var KEY = "itowns-theme";
                var LANG_KEY = "itowns-lang";

                function readIsDark() {
                    try {
                        var s = localStorage.getItem(KEY);
                        if (s === "light") return false;
                        if (s === "dark") return true;
                        return true;
                    } catch (e) {
                        return true;
                    }
                }
                function readLang() {
                    try {
                        var ls = localStorage.getItem(LANG_KEY);
                        if (ls === "fr" || ls === "en") return ls;
                    } catch (e2) {}
                    return "en";
                }
                function applyLang(code) {
                    document.documentElement.dataset.lang = code;
                    document.documentElement.setAttribute("lang", code);
                    try {
                        localStorage.setItem(LANG_KEY, code);
                    } catch (e3) {}
                    var langToggleLabel =
                        code === "fr"
                            ? {
                                  aria: "Afficher le site en anglais",
                                  title: "English version",
                              }
                            : {
                                  aria: "Afficher le site en français",
                                  title: "Version française",
                              };
                    var langBtns = document.querySelectorAll(".lang-toggle");
                    for (var j = 0; j < langBtns.length; j++) {
                        var lb = langBtns[j];
                        if (lb && lb.setAttribute) {
                            lb.setAttribute("aria-label", langToggleLabel.aria);
                            lb.setAttribute("title", langToggleLabel.title);
                            lb.setAttribute(
                                "aria-pressed",
                                code === "fr" ? "true" : "false",
                            );
                        }
                    }
                    var nav = document.querySelector(".nav-container");
                    if (nav && nav.setAttribute) {
                        nav.setAttribute(
                            "aria-label",
                            code === "fr"
                                ? "Navigation principale"
                                : "Main navigation",
                        );
                    }
                    var hamburger = document.querySelector(".hamburger");
                    if (hamburger && hamburger.setAttribute) {
                        hamburger.setAttribute(
                            "aria-label",
                            code === "fr"
                                ? "Ouvrir ou fermer le menu"
                                : "Toggle menu",
                        );
                    }
                    var communityPanel =
                        document.querySelector(".community-panel");
                    if (communityPanel && communityPanel.setAttribute) {
                        communityPanel.setAttribute(
                            "aria-label",
                            code === "fr"
                                ? "Contributeurs principaux — communauté GitHub"
                                : "Main contributors — GitHub community",
                        );
                    }
                    var logo = document.querySelectorAll(".logo");
                    for (var li = 0; li < logo.length; li++) {
                        var lg = logo[li];
                        if (lg && lg.setAttribute) {
                            if (code === "fr") {
                                lg.setAttribute(
                                    "title",
                                    "Accueil iTowns (retour en haut de page si déjà sur la page)",
                                );
                                lg.setAttribute(
                                    "aria-label",
                                    "iTowns — accueil ou haut de page",
                                );
                            } else {
                                lg.setAttribute(
                                    "title",
                                    "iTowns home (scroll to top when already on the page)",
                                );
                                lg.setAttribute(
                                    "aria-label",
                                    "iTowns — home or top of page",
                                );
                            }
                        }
                    }
                    document
                        .querySelectorAll("[data-aria-en][data-aria-fr]")
                        .forEach(function (el) {
                            if (!el || !el.setAttribute) return;
                            var en = el.getAttribute("data-aria-en");
                            var fr = el.getAttribute("data-aria-fr");
                            if (en && fr) {
                                el.setAttribute(
                                    "aria-label",
                                    code === "fr" ? fr : en,
                                );
                            }
                        });
                    applyTheme(readIsDark());
                }
                function toggleLangFromClick() {
                    var cur =
                        document.documentElement.dataset.lang === "fr"
                            ? "fr"
                            : "en";
                    applyLang(cur === "fr" ? "en" : "fr");
                }
                function applyTheme(isDark) {
                    document.documentElement.dataset.theme = isDark
                        ? "dark"
                        : "light";
                    var meta = document.getElementById("meta-theme-color");
                    if (meta) {
                        meta.setAttribute(
                            "content",
                            isDark ? "#0f0f0f" : "#f1f1f1",
                        );
                    }
                    var lang =
                        document.documentElement.dataset.lang === "fr"
                            ? "fr"
                            : "en";
                    var nodes = document.querySelectorAll(".theme-toggle");
                    for (var i = 0; i < nodes.length; i++) {
                        var btn = nodes[i];
                        if (
                            btn &&
                            btn.setAttribute &&
                            btn.tagName === "BUTTON"
                        ) {
                            btn.setAttribute(
                                "aria-pressed",
                                isDark ? "true" : "false",
                            );
                            var labelWhenDark =
                                lang === "fr"
                                    ? "Activer le thème clair"
                                    : "Enable light theme";
                            var labelWhenLight =
                                lang === "fr"
                                    ? "Activer le thème sombre"
                                    : "Enable dark theme";
                            var titleWhenDark =
                                lang === "fr"
                                    ? "Passer au thème clair"
                                    : "Toggle light / dark theme";
                            var titleWhenLight =
                                lang === "fr"
                                    ? "Passer au thème sombre"
                                    : "Toggle light / dark theme";
                            btn.setAttribute(
                                "aria-label",
                                isDark ? labelWhenDark : labelWhenLight,
                            );
                            btn.setAttribute(
                                "title",
                                isDark ? titleWhenDark : titleWhenLight,
                            );
                        }
                    }
                }
                function toggleTheme() {
                    var isDark =
                        document.documentElement.dataset.theme === "dark";
                    var next = !isDark;
                    try {
                        localStorage.setItem(KEY, next ? "dark" : "light");
                    } catch (e) {}
                    applyTheme(next);
                }
                function onDocClickCapture(e) {
                    if (e.button !== 0) return;
                    var t = e.target;
                    if (!t || typeof t.closest !== "function") return;
                    if (t.closest(".lang-toggle")) {
                        e.preventDefault();
                        toggleLangFromClick();
                        return;
                    }
                    if (!t.closest(".theme-toggle")) return;
                    toggleTheme();
                }
                function onAfterSwap() {
                    applyLang(readLang());
                }
                if (!window.__itownsThemeUiBound) {
                    window.__itownsThemeUiBound = true;
                    document.addEventListener("click", onDocClickCapture, true);
                    document.addEventListener(
                        "astro:after-swap",
                        onAfterSwap,
                    );
                }
                applyLang(readLang());
            })();
        </script>
    </body>
</html>

<style>
    .skip-link {
        position: absolute;
        top: var(--px-10);
        left: var(--px-8);
        transform: translateY(-200%);
        padding: var(--px-12) var(--px-16);
        border-radius: var(--px-6);
        color: var(--color-white);
        background: var(--color-primary);
        z-index: 1001;
        opacity: 0;
        transition: opacity var(--transition-short);
    }

    .skip-link:focus-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>
